# PORT=3800

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=db_name

JWT_SECRET=supersecret
JWT_EXPIRATION=3600s # 1 hour

REDIS_HOST=localhost
REDIS_PORT=6379

# Optional: if set, GET /api/v1/health fails when heap exceeds this many MB (OOM guard).
# HEALTH_CHECK_HEAP_MB=512


# Failed jobs: cap count and max age (seconds) so Redis does not grow without bound.
BULL_REMOVE_ON_FAIL_MAX_AGE_SEC=86400
BULL_REMOVE_ON_FAIL_MAX_COUNT=5000
# Non-production only: keep a small completed history for Bull Board (count + max age seconds).
BULL_REMOVE_ON_COMPLETE_MAX_COUNT=100
BULL_REMOVE_ON_COMPLETE_MAX_AGE_SEC=3600
MONGO_URI=mongodb://localhost:27017/kadsipa_mis_logs

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=yourapppassword
SMTP_FROM_EMAIL=your@gmail.com
SEND_EMAILS=false
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5183